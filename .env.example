VERSION=0.1.0
# Local surfnet (`just surfpool`). WS defaults to the RPC port + 1 (ws://127.0.0.1:8900).
SOLANA_RPC_URL=http://127.0.0.1:8899
# SOLANA_WS_URL=ws://127.0.0.1:8900

# Must equal the IDL address (idls/zk_shielded_pool_solana.json). Default shown.
# PROGRAM_ID=FCrymxYUTEnXDJXdDn2E71KPxB9sBjXZCh1ezBwmUhvp

# Comma-separated base58 64-byte secret keys (e.g. `solana-keygen` JSON -> base58).
# Deposit wallets sign deposits and pay funds + fees. Withdraw wallets pay and sign
# upload_proof / withdraw / close_proof; the first one is the default fee payer.
# A key may not appear in both lists.
DEPOSIT_WALLET_PRIVATE_KEYS=<base58-secret>,<base58-secret>
WITHDRAW_WALLET_PRIVATE_KEYS=<base58-secret>

# zk deposit parameters, one file per deposit (contain the secret, gitignored)
ZK_DEPOSIT_DATA=./data/zk-deposit-params

RUST_LOG=info,tower_http=info
